APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cat_game
# Required and unique in APP_ENV=production; use at least 32 random bytes.
AUTH_RATE_LIMIT_SECRET=local-auth-rate-limit-secret
# Optional. Without this key cat chat uses the safe deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_MS=6000
